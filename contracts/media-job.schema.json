{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mozartg.github.io/mo-video-drops/contracts/media-job.schema.json",
  "title": "Media Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "lane", "input", "qa_profile"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "lane": {"type": "string", "enum": ["comfyui", "stock", "remotion", "ffmpeg", "other"]},
    "input": {"type": "object"},
    "qa_profile": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1, "default": 1},
    "priority": {"type": "integer", "minimum": 0, "default": 0},
    "rights_policy": {"type": "string"},
    "requested_output": {
      "type": "object",
      "properties": {
        "media_type": {"type": "string", "enum": ["image", "video", "audio", "document"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    }
  }
}
