{
  "name": "remotion",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.507",
    "@remotion/tailwind-v4": "4.0.507",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.507",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.507",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/input.test.ts",
    "render:trial": "remotion render src/index.ts DriveOutTrial out/trial.mp4 --props=inputs/trial.json",
    "verify:trial": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-trial.ps1",
    "render:long-form": "remotion render src/index.ts DriveOutLongForm out/long-form.mp4 --props=inputs/long-form.json --concurrency=12",
    "verify:long-form": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-long-form.ps1",
    "verify:long-form-artifact": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-long-form-artifact.ps1",
    "render:batch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-batch.ps1"
  },
  "sideEffects": [
    "*.css"
  ]
}
